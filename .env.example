# URBAN-COOL AI Environment Variables Configuration

# Backend Server Configuration
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://urban-cool-ai.vercel.app

# Frontend Configuration (Used by Next.js client & Vercel)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Earth Engine Integration (Phase 1 Remote Sensing Data)
GEE_PROJECT_ID=your-google-cloud-project-id
GEE_SERVICE_ACCOUNT=your-gee-service-account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OpenStreetMap Overpass API Endpoint
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
